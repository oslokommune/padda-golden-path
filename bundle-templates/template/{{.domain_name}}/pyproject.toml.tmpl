[project]
name = "{{template `package_name` .}}"
version = "0.1.0"
description = "{{.domain_description}}"
readme = "README.md"
# Databricks runs Python 3.12 on both serverless (environment versions 3-6)
# and classic compute (DBR 17.3 LTS). A stricter requires-python makes pip
# refuse the wheel on Databricks jobs. Bump requires-python, ruff
# target-version and mypy python_version together when Databricks ships a
# runtime with a newer Python.
# https://docs.databricks.com/aws/en/release-notes/serverless/environment-version/
# https://docs.databricks.com/aws/en/release-notes/runtime/17.3lts
requires-python = ">=3.12"
{{- if ne .include_ml_workflow "yes"}}
scripts = { "main" = "{{template `package_name` .}}.main:main" }
{{- end}}
classifiers = ["Programming Language :: Python :: 3.12", "Programming Language :: Python :: 3.13", "Operating System :: OS Independent"]
dependencies = [{{if eq .include_ml_workflow "yes"}}
    "mlflow-skinny>=3.0",
    "numpy>=1.26",
    "pandas>=2.0",
    "scikit-learn>=1.4",
    "torch>=2.4",
{{end}}]
{{- if eq .include_ml_workflow "yes"}}

[project.scripts]
main = "{{template `package_name` .}}.main:main"
ml_generate_data = "{{template `package_name` .}}.ml.tasks:generate_data"
ml_build_features = "{{template `package_name` .}}.ml.tasks:build_features"
ml_train = "{{template `package_name` .}}.ml.tasks:train"
ml_predict = "{{template `package_name` .}}.ml.tasks:predict"
{{- end}}

[dependency-groups]
dev = [
    "commitizen>=4.12",
    "databricks-connect==16.4.*",
    "databricks-sdk>=0.67.0",
    "mypy>=1.18.2",
{{- if eq .include_ml_workflow "yes"}}
    "pandas-stubs>=2.2",
{{- end}}
    "pip>=25.2",
    "prek>=0.2.30",
    "pydoclint>=0.7.3",
    "pytest>=8.4.2",
    "pytest-cov>=7.0.0",
    "pytest-mock>=3.15.1",
    "pytest-sugar>=1.1.1",
    "ruff>=0.13.1"
]

[build-system]
requires = ["hatchling>=1.25"]
build-backend = "hatchling.build"

[tool.uv]
package = true

[tool.ruff]
target-version = "py312"
line-length = 100
extend-include = ["*.ipynb"]
extend-exclude = ["scratch"]
builtins = ["dbutils", "display", "spark"]

[tool.ruff.lint]
pydocstyle.convention = "numpy"
external = ["DOC"]
select = ["ALL"]
ignore = [
    "BLE001",   # "Do not catch blind exception: `Exception`"
    "COM812",   # "Checks for the absence of trailing commas" - redundant when used in tandem with the formatter
    "D100",     # "Missing docstring in public module"
    "D104",     # "Missing docstring in public package"
    "D105",     # "Missing docstring in magic method"
    "D106",     # "Missing docstring in public nested class"
    "D107",     # "Missing docstring in __init__"
    "D203",     # "One blank line required before class docstring" - should be disabled by default
    "D213",     # "Multi-line docstring summary should start at the second line" - should be disabled by default
    "D400",     # "First line should end with a period"
    "D401",     # "First line of docstring should be in imperative mood"
    "ERA001",   # "Found commented out code"
    "FBT001",   # "Boolean positional arg in function definition"
    "FBT002",   # "Boolean default value in function definition"
    "FBT003",   # "Boolean positional value in function call"
    "G004",     # "Logging statement uses f-string"
    "ISC001",   # "Implicit string concatenation" - conflicts with the formatter
    "N812",     # "Lowercase `functions` imported as non-lowercase"
    "PLR2004",  # "Magic value used in comparison, consider replacing with a constant variable"
    "T201",     # "`print` found"
    "TRY003"    # "Avoid specifying long messages outside the exception class"
]

[tool.ruff.lint.per-file-ignores]
".vscode/**/*.pyi" = [
    "F403",     # "Blanket import used" - needed for type stubs
]
"notebooks/**/*.py" = [
    "D100",     # "Missing docstring in public module" - not needed for Databricks notebooks
    "INP001",   # "Part of an implicit namespace package. Add an `__init__.py`" - not needed for Databricks notebooks
]
"tests/*.py" = [
    "PLR2004",  # "Magic value used in comparison, consider replacing with a constant variable"
    "S101",     # "Use of `assert` detected"
]

[tool.mypy]
packages = ["{{template `package_name` .}}"]
mypy_path = "src"
python_version = "3.12"
strict = true
disallow_untyped_decorators = false
exclude = "scratch"
{{- if eq .include_ml_workflow "yes"}}

[[tool.mypy.overrides]]
# scikit-learn ships no type information; pyspark comes from databricks-connect.
module = ["sklearn.*", "pyspark.*"]
ignore_missing_imports = true
{{- end}}

[tool.pytest.ini_options]
testpaths = ["tests"]
pythonpath = ["src"]

[tool.coverage.run]
omit = ["*/__init__.py"]

[tool.pydoclint]
style = "numpy"
exclude = ".git|.venv|scratch"

[tool.commitizen]
name = "cz_conventional_commits"
tag_format = "$version"
version_scheme = "pep440"
version_provider = "uv"
update_changelog_on_bump = true
