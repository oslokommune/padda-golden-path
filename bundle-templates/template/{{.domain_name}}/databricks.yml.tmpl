bundle:
  name: {{.domain_name}}

include:
  - "resources/*.yml"

artifacts:
  platform:
    type: whl
    path: .
    build: uv build --wheel

variables:
  spark_version:
    description: Default Spark version for jobs that use classic compute.
    default: 17.3.x-scala2.13
  wheel_path:
    description: Path of the wheel file.
    default: ${workspace.root_path}/artifacts/.internal/*.whl
  catalog:
    description: Unity Catalog catalog for tables and schemas.
  schema:
    description: Default schema for tables.

targets:

  # The 'stage' target, used for development.
  stage:
    ## We use 'mode: development' to indicate this is a personal development copy:
    ## - Deployed resources get prefixed with '[dev my_user_name]'
    ## - Any job schedules and triggers are paused by default
    ## - The 'development' mode is used for pipelines
    mode: development
    default: true
    workspace:
      host: {{.stage_workspace_host}}
    presets:
      artifacts_dynamic_version: true
    variables:
      catalog: dev_catalog
      schema: default

  # The 'prod' target, used for production deployment.
  prod:
    mode: production
    workspace:
      host: {{.prod_workspace_host}}
      # '~/' resolves to the home directory of the identity that deploys, i.e.
      # the deploy service principal when deploying from GitHub Actions. The
      # '${bundle.target}' suffix prevents accidental collisions if multiple
      # targets ever deploy to the same workspace.
      root_path: ~/.bundle/${bundle.name}/${bundle.target}
    run_as:
      # Application ID (a UUID) of the deploy service principal, normally
      # {{template `service_principal_name` .}}. The display name does not work
      # here. Ask Dataspeilet for the ID.
      service_principal_name: REPLACE_WITH_APPLICATION_ID
    variables:
      catalog: prod_catalog
      schema: production
